{
  "version": 11,
  "kind": "flowchart",
  "draft": false,
  "configuration": {
    "$type": "mermaiden/configuration/flowchart/flowchart_diagram_configuration",
    "fields": {
      "wrap": true,
      "use_width": {
        "$type": "mermaiden/value/flowchart/omittable_number",
        "fields": {
          "root": {
            "$type": "mermaiden/value/flowchart/unconfigured",
            "fields": {}
          }
        }
      },
      "use_max_width": true,
      "theme": {
        "$type": "mermaiden/value/flowchart/omittable_theme",
        "fields": {
          "root": {
            "$enum": "mermaiden/enum/flowchart/mermaid_theme",
            "value": "redux-color"
          }
        }
      },
      "look": {
        "$type": "mermaiden/value/flowchart/omittable_look",
        "fields": {
          "root": {
            "$enum": "mermaiden/enum/flowchart/mermaid_look",
            "value": "neo"
          }
        }
      },
      "layout": {
        "$type": "mermaiden/value/flowchart/omittable_layout",
        "fields": {
          "root": {
            "$type": "mermaiden/value/flowchart/unconfigured",
            "fields": {}
          }
        }
      },
      "title_top_margin": 25,
      "sub_graph_title_margin": {
        "$type": "mermaiden/value/flowchart/flowchart_subgraph_title_margin",
        "fields": {
          "top": {
            "$type": "mermaiden/value/flowchart/omittable_non_negative_integer",
            "fields": {
              "root": 0
            }
          },
          "bottom": {
            "$type": "mermaiden/value/flowchart/omittable_non_negative_integer",
            "fields": {
              "root": 0
            }
          }
        }
      },
      "arrow_marker_absolute": {
        "$type": "mermaiden/value/flowchart/omittable_boolean",
        "fields": {
          "root": {
            "$type": "mermaiden/value/flowchart/unconfigured",
            "fields": {}
          }
        }
      },
      "diagram_padding": 8,
      "node_spacing": 50,
      "rank_spacing": 50,
      "curve": {
        "$enum": "mermaiden/enum/flowchart/flowchart_curve",
        "value": "basis"
      },
      "padding": 15.0,
      "wrapping_width": 120.0,
      "min_node_width": 120.0,
      "inherit_dir": false
    }
  },
  "elements": [
    {
      "$type": "mermaiden/element/flowchart/start",
      "fields": {
        "id": "start_example",
        "label": "Start example"
      }
    },
    {
      "$type": "mermaiden/element/flowchart/action",
      "fields": {
        "id": "process_example",
        "label": "Process example"
      }
    },
    {
      "$type": "mermaiden/element/flowchart/end",
      "fields": {
        "id": "end_example",
        "label": "End example"
      }
    }
  ],
  "relations": [
    {
      "$type": "mermaiden/relation/flowchart/flow",
      "fields": {
        "id": "first_example",
        "element_ids": [
          "start_example",
          "process_example"
        ],
        "label": ""
      }
    },
    {
      "$type": "mermaiden/relation/flowchart/flow",
      "fields": {
        "id": "second_example",
        "element_ids": [
          "process_example",
          "end_example"
        ],
        "label": ""
      }
    }
  ],
  "annotations": [],
  "properties": {
    "direction": {
      "$enum": "mermaiden/enum/flowchart/direction",
      "value": "TD"
    }
  }
}
