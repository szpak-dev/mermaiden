---
config:
  wrap: true
  sequence: {"useWidth": 960.0, "useMaxWidth": true, "theme": "redux-color", "look": "neo", "layout": "dagre", "arrowMarkerAbsolute": false, "hideUnusedParticipants": false, "activationWidth": 10, "diagramMarginX": 50, "diagramMarginY": 10, "actorMargin": 50, "width": 150, "height": 65, "boxMargin": 10, "boxTextMargin": 5, "noteMargin": 10, "messageMargin": 35, "messageAlign": "center", "mirrorActors": true, "forceMenus": false, "bottomMarginAdj": 1, "rightAngles": false, "showSequenceNumbers": false, "actorFontSize": 14.0, "actorFontFamily": "\"Open Sans\", sans-serif", "actorFontWeight": 400.0, "noteFontSize": 14.0, "noteFontFamily": "\"trebuchet ms\", verdana, arial, sans-serif", "noteFontWeight": 400.0, "noteAlign": "center", "messageFontSize": 16.0, "messageFontFamily": "\"trebuchet ms\", verdana, arial, sans-serif", "messageFontWeight": 400.0, "wrapPadding": 10.0, "labelBoxWidth": 50.0, "labelBoxHeight": 20.0}
---
sequenceDiagram
box #E3F2FD Clients
  actor user as User
  participant web@{ "type": "boundary" } as Web
end
box #F3E5F5 Backend
  participant api@{ "type": "control" } as API
  participant database@{ "type": "database" } as Database
end
participant events@{ "type": "queue" } as Events
autonumber
user->>+web: Open
web-)api: Forward
create participant worker@{ "type": "entity" } as Worker
api->>worker: Start job
loop retry
api-->>database: Query
par effects
api--)events: Publish
end
end
deactivate web
destroy worker
api->>worker: Stop job
Note left of user: Caller
Note right of web: Gateway
Note over api,events: Asynchronous
